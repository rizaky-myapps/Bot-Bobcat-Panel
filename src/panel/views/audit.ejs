<%- include('partials/header') %>

<form class="card card-body filters" method="get" action="/journal">
  <div class="field grow"><label for="q">Recherche</label><input class="input" id="q" name="q" value="<%= query.q || '' %>" placeholder="Texte de l'action…"></div>
  <div class="field">
    <label for="source">Origine</label>
    <select class="input" id="source" name="source">
      <option value="">Toutes</option>
      <option value="bot" <%= query.source === 'bot' ? 'selected' : '' %>>Discord</option>
      <option value="panel" <%= query.source === 'panel' ? 'selected' : '' %>>Panel</option>
    </select>
  </div>
  <div class="field">
    <label for="action">Domaine</label>
    <select class="input" id="action" name="action">
      <option value="">Tous</option>
      <% for (const f of families) { %><option value="<%= f %>" <%= query.action === f ? 'selected' : '' %>><%= f %></option><% } %>
    </select>
  </div>
  <div class="form-actions"><button class="btn primary" type="submit">Filtrer</button><a class="btn ghost" href="/journal">Réinitialiser</a></div>
</form>

<section class="card">
  <% if (!logs.length) { %>
    <div class="empty"><span class="big">🧾</span>Aucune entrée.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Date</th><th>Auteur</th><th>Origine</th><th>Action</th><th>Détail</th></tr></thead>
        <tbody>
          <% for (const l of logs) { %>
            <tr>
              <td class="nowrap num"><%= fmt.dateTime(l.createdAt) %></td>
              <td><%- l.actorId ? include('partials/member', { id: l.actorId }) : '<span class="muted">Système</span>' %></td>
              <td><span class="badge plain <%= l.source === 'panel' ? 'accent' : 'info' %>"><%= l.source === 'panel' ? 'Panel' : 'Discord' %></span></td>
              <td><code><%= l.action %></code></td>
              <td><%= l.summary %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
  <%- include('partials/pagination', { base: '/journal' }) %>
</section>

<%- include('partials/footer') %>
