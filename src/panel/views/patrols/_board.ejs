<% if (!board.rows.length) { %>
  <div class="card empty"><span class="big">📍</span>Aucun lieu actif. <a class="link" href="/lieux">Configurer les lieux</a></div>
<% } else { %>
  <% for (const group of [{ title: '🟢 Lieux disponibles', rows: board.available }, { title: '🚫 Limite atteinte', rows: board.reached }]) { if (!group.rows.length) continue; %>
    <section>
      <h2 style="margin:4px 0 10px"><%= group.title %> (<%= group.rows.length %>)</h2>
      <div class="place-grid">
        <% for (const r of group.rows) { %>
          <div class="card place-card">
            <div class="top">
              <span style="font-size:18px"><%- include('../partials/emoji', { value: r.emoji }) %></span>
              <span class="name"><%= r.name %></span>
              <% if (r.unlimited) { %><span class="badge info plain" style="margin-left:auto">Illimité</span>
              <% } else if (r.reached) { %><span class="badge danger" style="margin-left:auto">Limite atteinte</span>
              <% } else { %><span class="badge <%= r.percent >= 75 ? 'warn' : 'ok' %>" style="margin-left:auto"><%= r.percent %> %</span><% } %>
            </div>
            <% if (!r.unlimited) { %>
              <div class="meter <%= r.reached ? 'danger' : r.percent >= 75 ? 'warn' : '' %>" role="meter" aria-valuenow="<%= r.percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= r.name %>"><span style="width:<%= r.percent %>%"></span></div>
            <% } %>
            <div class="figures num">
              <span><%= fmt.duration(r.usedMinutes) %><%= r.unlimited ? ' utilisées' : ` / ${fmt.duration(r.maxMinutes)}` %></span>
              <% if (!r.unlimited) { %><span><%= r.reached ? 'Épuisé' : `Reste ${fmt.duration(r.remaining)}` %></span><% } %>
            </div>
            <% if (perms.super) { %>
              <form method="post" action="/temps/reset" data-confirm="Réinitialiser le temps de « <%= r.name %> » pour la semaine <%= board.week %> ?">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="placeId" value="<%= r.placeId %>"><input type="hidden" name="year" value="<%= board.year %>"><input type="hidden" name="week" value="<%= board.week %>">
                <button class="btn sm ghost" type="submit">♻️ Réinitialiser</button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>
  <p class="muted small" style="margin:0">Total de la semaine : <strong><%= fmt.duration(board.totalMinutes) %></strong> · mis à jour à <%= fmt.hm(new Date()) %></p>
<% } %>
