# --- Discord -------------------------------------------------------------------
# Portail développeur : https://discord.com/developers/applications
# Bot → Reset Token
DISCORD_TOKEN=
# OAuth2 → Client ID / Client Secret (connexion au panel)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord géré (clic droit sur le serveur → Copier l'identifiant, mode développeur activé)
GUILD_ID=

# --- Base de données -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/bobcat

# --- Super-users (toujours autorisés, en plus du propriétaire du serveur) ----------
# IDs Discord séparés par des virgules
SUPER_USER_IDS=
SUPER_USER_ROLE_IDS=

# --- Panel web ---------------------------------------------------------------------
PANEL_PORT=3000
# URL publique du panel (sert à l'URL de retour OAuth2 : <PANEL_BASE_URL>/auth/callback)
PANEL_BASE_URL=http://localhost:3000
# Chaîne aléatoire longue (ex : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PANEL_SESSION_SECRET=
# Connexion sans Discord pour tester en local (ignorée si NODE_ENV=production)
PANEL_DEV_LOGIN=false
PANEL_DEV_USER_ID=

# --- Cloudinary (photos des PDS, optionnel) -----------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bobcat

# --- Divers ------------------------------------------------------------------------
# Fuseau horaire utilisé pour lire et afficher les heures (laisser vide = fuseau du système)
TZ=Europe/Paris
NODE_ENV=development
# Emojis personnalisés du serveur (format <:nom:id>), optionnels
EMOJI_BOBCAT=
EMOJI_SHOTGUN=
EMOJI_CO_ATM=
EMOJI_U2R=
BRAND_NAME=Bobcat Security
